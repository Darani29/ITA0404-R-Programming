#exp 15
# Load iris dataset
data(iris)

# Display dimensions
dim(iris)

# Summary statistics
summary(iris)

# Standard deviation
sapply(iris[, 1:4], sd)

# Quantiles
sapply(iris[, 1:4], quantile)

# Grouping by Species
aggregate(. ~ Species, data = iris, FUN = mean)

# Pivot table: mean Sepal.Length by Species
with(iris, tapply(Sepal.Length, Species, mean))

# Create Sepal.Length categories
iris$Sepal_Category <- cut(
  iris$Sepal.Length,
  breaks = c(4, 5, 6, 7, 8),
  labels = c("4-5", "5-6", "6-7", "7-8"),
  include.lowest = TRUE
)

# Categorical grouping
table(iris$Sepal_Category, iris$Species)

