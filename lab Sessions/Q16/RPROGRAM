# exp 16
# Load dataset
data(USArrests)

# Summary statistics
summary(USArrests)

# State with largest Rape arrests
state_rape <- rownames(USArrests)[which.max(USArrests$Rape)]
print(state_rape)

# Maximum and minimum Murder rates
max_murder <- max(USArrests$Murder)
min_murder <- min(USArrests$Murder)

print(max_murder)
print(min_murder)

# Correlation among features
print(cor(USArrests))

# States above median Assault arrests
median_assault <- median(USArrests$Assault)
above_median_assault <- USArrests[USArrests$Assault > median_assault, ]
print(above_median_assault)

# Bottom 25% for Murder
q1_murder <- quantile(USArrests$Murder, 0.25)
bottom_25_murder <- USArrests[USArrests$Murder <= q1_murder, ]
print(bottom_25_murder)

# Histogram
hist(USArrests$Murder,
     main = "Histogram of Murder Arrests",
     xlab = "Murder Arrests",
     col = "skyblue")

# Density plot
plot(density(USArrests$Murder),
     main = "Density Plot of Murder Arrests",
     xlab = "Murder Arrests")

# Scatterplot
plot(USArrests$Assault, USArrests$Murder,
     main = "Assault vs Murder",
     xlab = "Assault",
     ylab = "Murder",
     pch = 19,
     col = "blue")

# Bar graph
barplot(USArrests$Murder,
        names.arg = rownames(USArrests),
        las = 2,
        col = "orange",
        main = "Murder Arrests by State",
        ylab = "Murder Arrests")
